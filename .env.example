# ---------------------------------------------------------------
# LogAi configuration. Copy to .env and edit.
# ---------------------------------------------------------------

# --- listeners -------------------------------------------------
# 514 is privileged; 5514 runs without sudo. Point your devices here.
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
SYSLOG_BIND=0.0.0.0
API_PORT=8080
DB_PATH=logai.db

# --- AI provider -----------------------------------------------
# Pick ONE. Everything else stays commented out.
# Options: ollama | vllm | openrouter | openai | anthropic | offline | none
#   'offline' runs the full agent path with a built-in rules fixture —
#            no model, no network. Use this when the venue wifi is bad.
#   'none'    disables AI review entirely; ranking still works.

# No model, no network, no GPU — the whole pipeline still demonstrates:
# LOGAI_PROVIDER=offline

# Local, no key required, nothing leaves the building:
LOGAI_PROVIDER=ollama
LOGAI_MODEL=qwen2.5:14b
# LOGAI_BASE_URL=http://localhost:11434/v1

# Local via vLLM:
# LOGAI_PROVIDER=vllm
# LOGAI_MODEL=Qwen/Qwen2.5-14B-Instruct
# LOGAI_BASE_URL=http://localhost:8000/v1

# OpenRouter (many models behind one key):
# LOGAI_PROVIDER=openrouter
# LOGAI_MODEL=meta-llama/llama-3.3-70b-instruct
# LOGAI_API_KEY=sk-or-...

# OpenAI:
# LOGAI_PROVIDER=openai
# LOGAI_MODEL=gpt-4o-mini
# LOGAI_API_KEY=sk-...

# Anthropic:
# LOGAI_PROVIDER=anthropic
# LOGAI_MODEL=claude-sonnet-4-6
# LOGAI_API_KEY=sk-ant-...

# --- agent behaviour -------------------------------------------
ANALYZE_TOP_N=5
SAMPLES_PER_CLUSTER=4
ALERT_SCORE_THRESHOLD=80
LOGAI_TIMEOUT=120
LOGAI_MAX_TOKENS=1400
# Set >0 to run triage automatically every N seconds. 0 = manual only.
AUTO_ANALYZE_SECONDS=0
